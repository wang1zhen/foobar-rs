<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>rs.foobar_rs</id>
  <name>foobar-rs</name>
  <summary>foobar2000 风格音乐播放器</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>foobar-rs 是基于 Rust + egui 的跨平台音乐播放器，界面与操作习惯接近 foobar2000。</p>
    <p>功能：</p>
    <ul>
      <li>本地媒体库扫描与播放列表管理</li>
      <li>Navidrome 远程音乐源</li>
      <li>WASM 插件</li>
    </ul>
  </description>
  <launchable type="desktop-id">rs.foobar_rs.desktop</launchable>
  <provides>
    <binary>fb-app</binary>
  </provides>
